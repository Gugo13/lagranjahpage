---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nuestros sponsors</title>
  </head>
  <body>
    <section class="sponsors-section" id="sponsors">
      <div class="container" id="sponsors">
        <h1
          class="section-title text-3xl md:text-5xl font-black uppercase text-slate-100 mt-4"
        >
          Nuestros <span class="text-rose-500">Sponsors</span>
        </h1>
        <h2 class="section-subtitle text-center">
          Hacete socio y disfrutá de los beneficios de ser parte de La Granjah
        </h2>

        <div class="sponsors-grid">
          <!-- Banner de Sponsor 1 -->
          <div class="sponsor-banner">
            <!-- 1. Izquierda: Logo con Sticker Dorado -->
            <div
              class="relative w-36 h-28 md:w-44 md:h-32 bg-neutral-950 border border-neutral-800 rounded-xl p-2 flex items-center justify-center shrink-0 shadow-inner"
            >
              <!-- Logo del sponsor -->
              <img
                src="/sponsors/uffPizza1.jpg"
                alt="Logo uff pizza"
                class="w-full h-full object-contain"
              />

              <!-- Sticker Escudo Dorado -->
              <img
                src="/escudo/LG-oro.png"
                alt="Sello Dorado"
                class="absolute -top-3 -right-3 w-9 h-9 md:w-11 md:h-11 object-contain drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] z-10"
                title="Sponsor con beneficio para socios"
              />
            </div>

            <!-- 2. Centro: Información y Botones -->
            <div class="sponsor-info">
              <h3
                style="color: #EAA023;"
                class="text-2xl font-black tracking-wide uppercase"
              >
                Uff!!
              </h3>
              <h2
                class="font-black uppercase tracking-wider text-neutral-900 my-1"
              >
                Pizza a la piedra
              </h2>
              <p>
                Encontranos por calle Vidart<br />entre Alfredo Rizo y
                Recabarren, Rawson
              </p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/5492644837928"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/uff_pizzaa?stkn=MXFicHJmNmh1aHAzbQ=="
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>

            <!-- 3. Derecha: Beneficios (Ancho fijo en desktop) -->
            <div class="sponsor-benefits w-full md:w-64 shrink-0 m-0">
              <h4>Días y horarios</h4>
              <p>
                Lunes a jueves de 20 a 00hs.<br />Viernes a domingo de
                20-horario extendido
              </p>
            </div>
          </div>

          <!-- Banner de Sponsor 2 -->
          <div class="sponsor-banner">
            <div
              class="w-36 h-28 md:w-44 md:h-32 bg-[#6486B2] border border-neutral-800 rounded-xl p-2 flex items-center justify-center overflow-hidden shrink-0 shadow-inner"
            >
              <img
                src="/sponsors/casaAlberdi2.jpg"
                alt="Logo Negocio 2"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="sponsor-info">
              <h3
                style="color: #6486B2;"
                class="text-2xl font-black tracking-wide uppercase"
              >
                Casa Alberdi
              </h3>
              <p>Indumentaria y accesorios.</p>
              <p>Encontranos en Av. Ignacio de la Rosa 619(Oeste)</p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/5492644436660"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/casaalberdi?stkn=MWt5ZXBld3cxbng3bA=="
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>
            <!-- Derecha: Beneficios (Ancho fijo en desktop) -->
            <div class="sponsor-benefits w-full md:w-64 shrink-0 m-0">
              <h4>Días y horarios</h4>
              <p>
                Lunes y Martes de 9:30-13:30 / 17-21 hs.<br />De Miércoles a
                Sábados horario de corrido
              </p>
            </div>
          </div>

          <!-- Banner de Sponsor 3 -->
          <div class="sponsor-banner">
            <div
              class="w-36 h-28 md:w-44 md:h-32 bg-[#C62828] border border-neutral-800 rounded-xl p-2 flex items-center justify-center overflow-hidden shrink-0 shadow-inner"
            >
              <img
                src="/sponsors/panzaLlena1.png"
                alt="Logo Negocio 3"
                class="w-full h-full object-contain"
              />
            </div>
            <div class="sponsor-info">
              <h3
                style="color: #C62828;"
                class="text-2xl font-black tracking-wide uppercase"
              >
                Panza LLena
              </h3>
              <p>
                Comidas por pedido, para eventos o reuniones.<br />Empanadas,
                pizzas y asados.
              </p>
              <p>Encontranos en Av. Libertador 3267(Oeste)</p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/5492644808630"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/panzallenasj?stkn=MXJ3cWZsNWE4dG5zdg=="
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>
            <!-- Derecha: Beneficios (Ancho fijo en desktop) -->
            <div class="sponsor-benefits w-full md:w-64 shrink-0 m-0">
              <h4>Días y horarios</h4>
              <p>Sábados y Domingos de 11:30 a 15 hs.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="footer-sponsors">
        <p>Gracias a nuestros sponsors por ser parte de esta familia</p>
      </div>
      <div class="sponsors-bottom-line"></div>
      <div class="sponsors-bottom-drip"></div>
    </section>
  </body>
</html>
