---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nuestros sponsors</title>
  </head>
  <body>
    <section class="sponsors-section" id="sponsors">
      <div class="container" id="sponsors">
        <h1 class="section-title">Nuestros Sponsors</h1>
        <h2 class="section-subtitle text-center">Hacete socio y disfrutá de los beneficios de ser parte de La Granjah</h2>

        <div class="sponsors-grid">
          <!-- Banner de Sponsor 1 -->
          <div class="sponsor-banner">
            <!-- 1. Izquierda: Logo -->
            <div class="w-36 h-28 md:w-44 md:h-32 bg-neutral-950 border border-neutral-800 rounded-xl p-2 flex items-center justify-center overflow-hidden shrink-0 shadow-inner">
              <img src="/sponsors/uffPizza1.jpg" alt="Logo uff pizza" class="w-full h-full object-contain" />
            </div>

            <!-- 2. Centro: Información y Botones -->
            <div class="sponsor-info">
              <h3 style="color: #EAA023;" class="text-2xl font-black tracking-wide uppercase">Uff!!</h3>
              <h2 class="font-black uppercase tracking-wider text-neutral-900 my-1">Pizza a la piedra</h2>
              <p>Encontranos por calle Vidart entre Alfredo Rizo y Recabarren, Rawson</p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/5492644837928"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/uff_pizzaa?stkn=MXFicHJmNmh1aHAzbQ=="
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>

            <!-- 3. Derecha: Beneficios -->
            <div class="sponsor-benefits flex flex-col items-center justify-center text-center flex-1 my-auto">
              <h4>Días y horarios</h4>
              <p>Lunes a jueves de 20 a 00hs</p>
              <p>Viernes a domingo a partir de las 20, horario extendido</p>
            </div>
          </div>

          <!-- Banner de Sponsor 2 -->
          <div class="sponsor-banner">
            <div class="w-36 h-28 md:w-44 md:h-32 bg-[#6486B2] border border-neutral-800 rounded-xl p-2 flex items-center justify-center overflow-hidden shrink-0 shadow-inner">
              <img src="/sponsors/casaAlberdi2.jpg" alt="Logo Negocio 2" class="w-full h-full object-contain" />
            </div>
            <div class="sponsor-info">
              <h3 style="color: #6486B2;" class="text-2xl font-black tracking-wide uppercase">Casa Alberdi</h3>
              <p>
                Indumentaria y accesorios.
              </p>
              <p>Encontranos en Av. Ignacio de la Rosa 619(Oeste)</p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/5492644436660"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/casaalberdi?stkn=MWt5ZXBld3cxbng3bA=="
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>
            <div class="sponsor-benefits">
              <h4>Días y horarios</h4>
              <p>De miércoles a Sábados horario de CORRIDO</p>
              <p>Promociones pagando en <strong>efectivo</strong></p>
            </div>
          </div>

          <!-- Banner de Sponsor 3 -->
          <div class="sponsor-banner">
            <div class="sponsor-logo-container">
              <img src="" alt="Logo Negocio 3" />
            </div>
            <div class="sponsor-info">
              <h3>Yerbas Uruguayas SJ</h3>
              <p>
                Productos de pimera calidad. Envíos a todo el país.
              </p>
              <p>Encontranos por Manuel Zaballa 686(Norte)ex calle Cabaña</p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/5492644880857"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://www.instagram.com/yerbasuruguayas.sj?stkn=bzNhYXJvamw1cDBj"
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>
            <div class="sponsor-benefits">
              <h4>Beneficio Exclusivo</h4>
              <p>2x1 en productos seleccionados durante los fines de semana.</p>
            </div>
          </div>

        </div>
      </div>
      <div class="footer-sponsors">
        <p>Gracias a nuestros sponsors por ser parte de esta familia</p>
      </div>
      <div class="sponsors-bottom-line"></div>
    <div class="sponsors-bottom-drip"></div>
    </section>
  </body>
</html>