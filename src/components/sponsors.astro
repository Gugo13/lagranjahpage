---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nuestros sponsors</title>
  </head>
  <body>
    <section class="sponsors-section">
      <div class="container">
        <h1 class="section-title">Nuestros Sponsors</h1>
        <h2 class="section-subtitle text-center">Hacete socio y disfrutá de los beneficios de ser parte de La Granjah</h2>

        <div class="sponsors-grid">
          <!-- Banner de Sponsor 1 -->
          <div class="sponsor-banner">
            <!-- 1. Izquierda: Logo -->
            <div class="sponsor-logo-container">
              <img src="../sponsors/sponsor1.webp" alt="Logo Hierba Mala" />
            </div>

            <!-- 2. Centro: Información y Botones -->
            <div class="sponsor-info">
              <h3>Hierba Mala</h3>
              <p>
                Tabaquería y Grow Shop. Todo lo que necesitas para tu cultivo y disfrute. Vení a visitarnos en el corazón de villa krause.
              </p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/549XXXXXXXXXX"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://instagram.com/tuusuario"
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>

            <!-- 3. Derecha: Beneficios -->
            <div class="sponsor-benefits">
              <h4>Beneficio Exclusivo</h4>
              <p>15% de descuento en efectivo presentando tu credencial de socio.</p>
            </div>
          </div>

          <!-- Banner de Sponsor 2 -->
          <div class="sponsor-banner">
            <div class="sponsor-logo-container">
              <img src="ruta-al-logo2.png" alt="Logo Negocio 2" />
            </div>
            <div class="sponsor-info">
              <h3>Negocio 2</h3>
              <p>
                Otra breve descripción de lo que ofrece este otro local o negocio amigo.
              </p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/549XXXXXXXXXX"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://instagram.com/tuusuario"
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>
            <div class="sponsor-benefits">
              <h4>Beneficio Exclusivo</h4>
              <p>Envío sin cargo en compras superiores a un monto mínimo.</p>
            </div>
          </div>

          <!-- Banner de Sponsor 3 -->
          <div class="sponsor-banner">
            <div class="sponsor-logo-container">
              <img src="ruta-al-logo.png" alt="Logo Negocio 3" />
            </div>
            <div class="sponsor-info">
              <h3>Negocio 3</h3>
              <p>
                Una breve descripción de lo que ofrece el local o negocio amigo.
              </p>
              <div class="sponsor-actions">
                <a
                  href="https://wa.me/549XXXXXXXXXX"
                  target="_blank"
                  class="btn-sponsor btn-whatsapp"
                >
                  <i class="fab fa-whatsapp"></i> WhatsApp
                </a>
                <a
                  href="https://instagram.com/tuusuario"
                  target="_blank"
                  class="btn-sponsor btn-instagram"
                >
                  <i class="fab fa-instagram"></i> Instagram
                </a>
              </div>
            </div>
            <div class="sponsor-benefits">
              <h4>Beneficio Exclusivo</h4>
              <p>2x1 en productos seleccionados durante los fines de semana.</p>
            </div>
          </div>

        </div>
      </div>
      <div class="footer-sponsors">
        <p>Gracias a nuestros sponsors por ser parte de esta familia</p>
      </div>
    </section>
  </body>
</html>