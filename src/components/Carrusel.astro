---
const fotos = [
  { url: "/disciplinas/futbol11/foto29.jpg", titulo: "Fútbol 11" },
  { url: "/disciplinas/futsalMasc/foto25.jpg", titulo: "Futsal Masculino" },
  { url: "/disciplinas/futsalFem/foto16.jpg", titulo: "Futsal Femenino" },
  { url: "/disciplinas/futbol11/foto28.jpg", titulo: "Fútbol 11" },
  { url: "/disciplinas/futsalMasc/foto26.jpg", titulo: "Futsal Masculino" },
  { url: "/disciplinas/futsalFem/foto17.jpg", titulo: "Futsal Femenino" },

];
---

<div class="relative max-w-4xl mx-auto mt-8 overflow-hidden rounded-2xl border border-neutral-800 shadow-2xl">
  <div id="carrusel-contenedor" class="flex transition-transform duration-500 ease-out">
    {fotos.map((foto) => (
      <div class="min-w-full relative h-[300px] md:h-[450px]">
        <img src={foto.url} alt={foto.titulo} class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-950 via-transparent to-transparent flex items-end p-6">
          <span class="bg-neutral-950/80 backdrop-blur text-amber-400 font-bold px-4 py-2 rounded-lg border border-neutral-800">
            {foto.titulo}
          </span>
        </div>
      </div>
    ))}
  </div>

  <button id="btn-prev" class="absolute left-4 top-1/2 -translate-y-1/2 bg-neutral-950/70 hover:bg-emerald-500 text-white hover:text-neutral-950 p-3 rounded-full transition border border-neutral-700">
    ❮
  </button>
  <button id="btn-next" class="absolute right-4 top-1/2 -translate-y-1/2 bg-neutral-950/70 hover:bg-emerald-500 text-white hover:text-neutral-950 p-3 rounded-full transition border border-neutral-700">
    ❯
  </button>
</div>

<script>
  const contenedor = document.getElementById('carrusel-contenedor');
  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');
  
  // Obtenemos el total dinámicamente desde los elementos renderizados
  const total = contenedor?.children.length || 0;
  let index = 0;

  function actualizarCarrusel() {
    if (contenedor) {
      contenedor.style.transform = `translateX(-${index * 100}%)`;
    }
  }

  btnNext?.addEventListener('click', () => {
    if (total === 0) return;
    index = (index + 1) % total;
    actualizarCarrusel();
  });

  btnPrev?.addEventListener('click', () => {
    if (total === 0) return;
    index = (index - 1 + total) % total;
    actualizarCarrusel();
  });
</script>