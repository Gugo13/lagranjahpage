  <script is:inline>
    // 1. Giro de Tarjetas
    document.querySelectorAll(".single-card-container").forEach((card) => {
      card.addEventListener("click", () => {
        card.classList.toggle("is-flipped");
      });
    });

    // 2. Lógica Menú Hamburguesa
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (menuBtn) {
      menuBtn.addEventListener("click", () => {
        if (mobileMenu) mobileMenu.classList.toggle("hidden");
        if (iconOpen) iconOpen.classList.toggle("hidden");
        if (iconClose) iconClose.classList.toggle("hidden");
      });
    }

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (mobileMenu) mobileMenu.classList.add("hidden");
        if (iconOpen) iconOpen.classList.remove("hidden");
        if (iconClose) iconClose.classList.add("hidden");
      });
    });

    // 3. Lógica de Campos Condicionales del Formulario
    const selectResidencia = document.getElementById("lugar-residencia");
    const campoSJ = document.getElementById("campo-departamento-sj");
    const campoOtraProvincia = document.getElementById("campo-otra-provincia");
    const campoOtroResidencia = document.getElementById(
      "campo-otro-residencia",
    );

    if (selectResidencia) {
      selectResidencia.addEventListener("change", (e) => {
        const val = e.target.value;
        if (campoSJ) campoSJ.classList.toggle("hidden", val !== "San Juan");
        if (campoOtraProvincia)
          campoOtraProvincia.classList.toggle(
            "hidden",
            val !== "Otra provincia",
          );
        if (campoOtroResidencia)
          campoOtroResidencia.classList.toggle("hidden", val !== "Otro");
      });
    }

    const radiosAsociarse = document.querySelectorAll(
      'input[name="quiere_asociarse"]',
    );
    const bloqueCategorias = document.getElementById("bloque-categorias-socio");
    const btnSubmit = document.getElementById("btn-submit-form");

    radiosAsociarse.forEach((radio) => {
      radio.addEventListener("change", (e) => {
        if (e.target.value === "Sí") {
          if (bloqueCategorias) bloqueCategorias.classList.remove("hidden");
          if (btnSubmit)
            btnSubmit.textContent = "Enviar Solicitud e Ir a Pagar";
        } else {
          if (bloqueCategorias) bloqueCategorias.classList.add("hidden");
          if (btnSubmit) btnSubmit.textContent = "Enviar Solicitud";
        }
      });
    });

    const selectAporte = document.getElementById("forma-aporte");
    const campoOtroAporte = document.getElementById("campo-otro-aporte");

    if (selectAporte) {
      selectAporte.addEventListener("change", (e) => {
        const val = e.target.value;
        if (campoOtroAporte)
          campoOtroAporte.classList.toggle("hidden", val !== "Otro");
      });
    }

    const radiosJuega = document.querySelectorAll(
      'input[name="juega_en_club"]',
    );
    const contenedorDeporte = document.getElementById("opciones-deporte");

    radiosJuega.forEach((radio) => {
      radio.addEventListener("change", (e) => {
        if (contenedorDeporte)
          contenedorDeporte.classList.toggle("hidden", e.target.value !== "Sí");
      });
    });

    // 4. Copiar Datos Brubank
    const btnCopyAlias = document.getElementById("btn-copy-alias");
    const btnCopyCuit = document.getElementById("btn-copy-cuit");

    if (btnCopyAlias) {
      btnCopyAlias.addEventListener("click", () => {
        navigator.clipboard.writeText("granjah.socios.bru");
        btnCopyAlias.textContent = "¡Copiado!";
        btnCopyAlias.classList.add("bg-emerald-400");
        setTimeout(() => {
          btnCopyAlias.textContent = "Copiar";
          btnCopyAlias.classList.remove("bg-emerald-400");
        }, 2000);
      });
    }

    if (btnCopyCuit) {
      btnCopyCuit.addEventListener("click", () => {
        navigator.clipboard.writeText("27382188131");
        btnCopyCuit.textContent = "¡Copiado!";
        btnCopyCuit.classList.add("bg-emerald-500", "text-neutral-950");
        setTimeout(() => {
          btnCopyCuit.textContent = "Copiar";
          btnCopyCuit.classList.remove("bg-emerald-500", "text-neutral-950");
        }, 2000);
      });
    }

    // 5. Envío y Validación del Formulario
    const form = document.getElementById("mi-formulario-actual");
    const bloquePago = document.getElementById("bloque-pago-brubank");
    const inputNombre = document.getElementById("nombre");
    const inputDoc = document.getElementById("numero-doc");
    const inputFecha = document.getElementById("fecha-nacimiento");
    const inputEmail = document.getElementById("email");
    const inputTelefono = document.getElementById("telefono");
    const selectCodigoPais = document.getElementById("codigo-pais");
    const inputTelefonoCompleto = document.getElementById("telefono-completo");

    const errorNombre = document.getElementById("error-nombre");
    const errorDoc = document.getElementById("error-doc");
    const errorFecha = document.getElementById("error-fecha");
    const errorEmail = document.getElementById("error-email");
    const errorTelefono = document.getElementById("error-telefono");

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();

        let esValido = true;

        // Validación Nombre
        const regexNombre = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;
        if (
          !inputNombre ||
          !inputNombre.value.trim() ||
          !regexNombre.test(inputNombre.value.trim())
        ) {
          if (errorNombre) errorNombre.classList.remove("hidden");
          if (inputNombre) inputNombre.classList.add("border-red-500");
          esValido = false;
        } else {
          if (errorNombre) errorNombre.classList.add("hidden");
          if (inputNombre) inputNombre.classList.remove("border-red-500");
        }

        // Validación Documento
        const regexNumeros = /^[0-9]+$/;
        if (
          !inputDoc ||
          !inputDoc.value.trim() ||
          !regexNumeros.test(inputDoc.value.trim())
        ) {
          if (errorDoc) errorDoc.classList.remove("hidden");
          if (inputDoc) inputDoc.classList.add("border-red-500");
          esValido = false;
        } else {
          if (errorDoc) errorDoc.classList.add("hidden");
          if (inputDoc) inputDoc.classList.remove("border-red-500");
        }

        // Validación Fecha
        if (!inputFecha || !inputFecha.value) {
          if (errorFecha) errorFecha.classList.remove("hidden");
          if (inputFecha) inputFecha.classList.add("border-red-500");
          esValido = false;
        } else {
          if (errorFecha) errorFecha.classList.add("hidden");
          if (inputFecha) inputFecha.classList.remove("border-red-500");
        }

        // Validación Email
        const emailValor = inputEmail
          ? inputEmail.value.trim().toLowerCase()
          : "";
        if (
          !emailValor.endsWith("@gmail.com") &&
          !emailValor.endsWith("@hotmail.com")
        ) {
          if (errorEmail) errorEmail.classList.remove("hidden");
          if (inputEmail) inputEmail.classList.add("border-red-500");
          esValido = false;
        } else {
          if (errorEmail) errorEmail.classList.add("hidden");
          if (inputEmail) inputEmail.classList.remove("border-red-500");
        }

        // Validación Teléfono
        const telValor = inputTelefono ? inputTelefono.value.trim() : "";
        if (!telValor || !regexNumeros.test(telValor)) {
          if (errorTelefono) errorTelefono.classList.remove("hidden");
          if (inputTelefono) inputTelefono.classList.add("border-red-500");
          esValido = false;
        } else {
          if (errorTelefono) errorTelefono.classList.add("hidden");
          if (inputTelefono) inputTelefono.classList.remove("border-red-500");
          if (inputTelefonoCompleto && selectCodigoPais) {
            inputTelefonoCompleto.value = `'${selectCodigoPais.value} ${telValor}`;
          }
        }

        if (esValido) {
          if (btnSubmit) {
            btnSubmit.textContent = "Guardando solicitud...";
            btnSubmit.disabled = true;
            btnSubmit.classList.add("opacity-50", "cursor-not-allowed");
          }

          const formData = new FormData(form);

          fetch(form.action, {
            method: "POST",
            body: formData,
          })
            .then(() => {
              form.classList.add("hidden");
              if (bloquePago) bloquePago.classList.remove("hidden");
            })
            .catch((err) => {
              console.error("Error al guardar:", err);
              form.classList.add("hidden");
              if (bloquePago) bloquePago.classList.remove("hidden");
            });
        }
      });
    }

    // 6. Lógica del Modal de Disciplinas
    const fotosDisciplinas = {
      "futbol 11": [
        "/disciplinas/futbol11/foto1.jpg",
        "/disciplinas/futbol11/foto2.jpg",
        "/disciplinas/futbol11/foto3.jpg",
        "/disciplinas/futbol11/foto4.jpg",
        "/disciplinas/futbol11/foto5.jpg",
        "/disciplinas/futbol11/foto6.jpg",
        "/disciplinas/futbol11/foto7.jpg",
        "/disciplinas/futbol11/foto8.jpg",
        "/disciplinas/futbol11/foto9.jpg",
        "/disciplinas/futbol11/foto10.jpg",
      ],
      "futsal masculino": [
        "/disciplinas/futsalMasc/foto1.jpg",
        "/disciplinas/futsalMasc/foto2.jpg",
        "/disciplinas/futsalMasc/foto3.jpg",
        "/disciplinas/futsalMasc/foto4.jpg",
        "/disciplinas/futsalMasc/foto5.jpg",
        "/disciplinas/futsalMasc/foto6.jpg",
        "/disciplinas/futsalMasc/foto7.jpg",
        "/disciplinas/futsalMasc/foto8.jpg",
        "/disciplinas/futsalMasc/foto9.jpg",
        "/disciplinas/futsalMasc/foto10.jpg",
      ],
      "futsal femenino": [
        "/disciplinas/futsalFem/foto1.jpg",
        "/disciplinas/futsalFem/foto2.jpg",
        "/disciplinas/futsalFem/foto3.jpg",
        "/disciplinas/futsalFem/foto4.jpg",
        "/disciplinas/futsalFem/foto5.jpg",
        "/disciplinas/futsalFem/foto6.jpg",
        "/disciplinas/futsalFem/foto7.jpg",
        "/disciplinas/futsalFem/foto8.jpg",
        "/disciplinas/futsalFem/foto9.jpg",
        "/disciplinas/futsalFem/foto10.jpg",
      ],
    };

    let fotosActuales = [];
    let fotoIndex = 0;

    const sportCards = document.querySelectorAll(".sport-card");
    const modal = document.getElementById("sport-modal");
    const modalContainer = document.getElementById("modal-container");
    const closeModalBtn = document.getElementById("close-sport-modal");

    const modalIcon = document.getElementById("modal-icon");
    const modalSportTitle = document.getElementById("modal-sport-title");
    const categoryContainer = document.getElementById(
      "category-selector-container",
    );
    const matchesListContainer = document.getElementById(
      "matches-list-container",
    );

    const carruselImg = document.getElementById("modal-carrusel-img");
    const carruselContador = document.getElementById("modal-carrusel-contador");
    const btnPrev = document.getElementById("modal-prev-btn");
    const btnNext = document.getElementById("modal-next-btn");

    function actualizarFotoModal(index) {
      if (!fotosActuales || fotosActuales.length === 0) return;
      if (carruselImg) carruselImg.src = fotosActuales[index];
      if (carruselContador)
        carruselContador.textContent = `${index + 1} / ${fotosActuales.length}`;
    }

    const avanzarFoto = (e) => {
      if (e) e.stopPropagation();
      if (fotosActuales.length === 0) return;
      fotoIndex = (fotoIndex + 1) % fotosActuales.length;
      actualizarFotoModal(fotoIndex);
    };

    const retrocederFoto = (e) => {
      if (e) e.stopPropagation();
      if (fotosActuales.length === 0) return;
      fotoIndex = (fotoIndex - 1 + fotosActuales.length) % fotosActuales.length;
      actualizarFotoModal(fotoIndex);
    };

    if (btnPrev) btnPrev.addEventListener("click", retrocederFoto);
    if (btnNext) btnNext.addEventListener("click", avanzarFoto);
    if (carruselImg) carruselImg.addEventListener("click", avanzarFoto);

    function renderMatches(matches) {
      if (!matchesListContainer) return;
      if (!matches || matches.length === 0) {
        matchesListContainer.innerHTML = `<p class="text-sm text-slate-500 text-center py-4">No hay partidos cargados para esta categoría.</p>`;
        return;
      }

      matchesListContainer.innerHTML = matches
        .map(
          (m) => `
      <div class="bg-neutral-950 border border-neutral-800 p-4 rounded-xl flex flex-col md:flex-row md:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="bg-neutral-900 text-amber-400 border border-amber-500/20 text-xs font-black px-2.5 py-1 rounded-md whitespace-nowrap">
            ${m.fecha}
          </span>
          <div>
            <p class="text-sm font-black text-slate-100">vs ${m.rival}</p>
            <p class="text-xs text-slate-400">${m.cancha}</p>
          </div>
        </div>
        <div class="flex items-center justify-between md:justify-end gap-3 border-t md:border-t-0 pt-2 md:pt-0 border-neutral-800">
          <span class="text-[10px] font-bold px-2 py-0.5 rounded ${m.condicion === "Local" ? "bg-emerald-500/20 text-emerald-400 border border-emerald-500/30" : "bg-neutral-800 text-slate-400"}">
            ${m.condicion}
          </span>
          <span class="text-xs font-semibold text-slate-300">
            🕒 ${m.dia}
          </span>
        </div>
      </div>
    `,
        )
        .join("");
    }

    const normalizarString = (str) =>
      str
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/\s+/g, " ")
        .trim();

    sportCards.forEach((card) => {
      card.addEventListener("click", () => {
        const rawTitle = card.getAttribute("data-sport-title") || "";
        const title = rawTitle.replace(/\s+/g, " ").trim();
        const icon = card.getAttribute("data-sport-icon");
        const categories = JSON.parse(
          card.getAttribute("data-categories") || "[]",
        );

        if (modalIcon) modalIcon.textContent = icon;
        if (modalSportTitle) modalSportTitle.textContent = title;

        const busqueda = normalizarString(title);
        const claveEncontrada = Object.keys(fotosDisciplinas).find(
          (key) => normalizarString(key) === busqueda,
        );

        fotosActuales = claveEncontrada
          ? fotosDisciplinas[claveEncontrada]
          : [];
        fotoIndex = 0;

        const contenedorCarrusel = document.getElementById("modal-carrusel");

        if (fotosActuales.length > 0) {
          if (contenedorCarrusel) {
            contenedorCarrusel.style.display = "flex";
            contenedorCarrusel.classList.remove("hidden");
          }
          actualizarFotoModal(0);
        } else {
          if (contenedorCarrusel) {
            contenedorCarrusel.style.display = "none";
            contenedorCarrusel.classList.add("hidden");
          }
        }

        if (categoryContainer) {
          categoryContainer.innerHTML = categories
            .map(
              (cat, index) => `
        <button 
          data-cat-index="${index}"
          class="cat-btn ${index === 0 ? "bg-amber-400 text-neutral-950 font-black" : "bg-neutral-800 text-slate-300 hover:bg-neutral-700"} text-xs px-3.5 py-2 rounded-lg transition font-bold">
          ${cat.name}
        </button>
      `,
            )
            .join("");
        }

        if (categories.length > 0) {
          renderMatches(categories[0].matches);
        }

        const catBtns = categoryContainer
          ? categoryContainer.querySelectorAll(".cat-btn")
          : [];
        catBtns.forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            catBtns.forEach((b) => {
              b.classList.remove(
                "bg-amber-400",
                "text-neutral-950",
                "font-black",
              );
              b.classList.add("bg-neutral-800", "text-slate-300");
            });
            btn.classList.remove("bg-neutral-800", "text-slate-300");
            btn.classList.add("bg-amber-400", "text-neutral-950", "font-black");

            const catIdx = btn.getAttribute("data-cat-index");
            if (catIdx !== null)
              renderMatches(categories[parseInt(catIdx)].matches);
          });
        });

        if (modal) modal.classList.remove("hidden");
        setTimeout(() => {
          if (modal) modal.classList.remove("opacity-0");
          if (modalContainer) modalContainer.classList.remove("scale-95");
          actualizarFotoModal(0);
        }, 10);
      });
    });

    const closeModal = () => {
      if (modal) modal.classList.add("opacity-0");
      if (modalContainer) modalContainer.classList.add("scale-95");
      setTimeout(() => {
        if (modal) modal.classList.add("hidden");
      }, 300);
    };

    if (closeModalBtn) closeModalBtn.addEventListener("click", closeModal);
    if (modal) {
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }
  </script>
</html>
