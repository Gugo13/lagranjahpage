              <div class="flex items-center gap-4 my-auto relative z-10">
                <div
                  id="contenedor-foto"
                  class="w-20 h-24 bg-slate-800 rounded-lg border-2 border-slate-700 flex items-center justify-center text-slate-400 text-xs font-medium text-center overflow-hidden shrink-0"
                >
                  SOCIO
                </div>
                <div class="flex flex-col gap-1">
                  <div>
                    <p
                      class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold"
                    >
                      Apellido y Nombre
                    </p>
                    <p
                      id="txt-nombre"
                      class="text-white font-bold text-base leading-tight"
                    >
                      -
                    </p>
                  </div>
                  <div>
                    <p
                      class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold"
                    >
                      Documento
                    </p>
                    <p id="txt-dni" class="text-slate-200 text-xs font-mono">
                      -
                    </p>
                  </div>
                  <div>
                    <p
                      class="text-[10px] text-slate-400 uppercase tracking-wider font-semibold"
                    >
                      Categoría
                    </p>
                    <p
                      id="txt-socio"
                      class="text-amber-400 font-mono font-bold text-xs"
                    >
                      Activo
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PIE DE PÁGINA -->
    <footer
      class="border-t border-neutral-800 bg-neutral-950 py-12 relative overflow-hidden"
    >
      <div
        class="max-w-6xl mx-auto px-6 flex flex-col items-center justify-center gap-6 text-center"
      >
        <div
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-neutral-700 bg-neutral-900 shadow-xl p-1 transition hover:scale-105 duration-300"
        >
          <img
            src="/escudo/escudoLagranjah.png"
            alt="Escudo Oficial La Granjah"
            class="w-full h-full object-cover rounded-full"
          />
        </div>

        <div class="flex flex-col items-center gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
          </div>
          <div>
            <span
              class="text-xl font-black uppercase text-slate-100 tracking-wider"
              >{titulo}</span
            >
            <p class="text-xs text-slate-400 mt-1">{subtitulo}</p>
          </div>
        </div>

        <p
          class="text-xs text-slate-500 border-t border-neutral-900 pt-6 w-full max-w-md"
        >
          &copy; {new Date().getFullYear()} La Granjah. Hecho con amor por y para
          el club.
        </p>
      </div>
    </footer>

    <!-- SCRIPT PRINCIPAL -->
    <script is:inline>
      // 1. Giro de Tarjetas Generales (Cards 3D)
      document.querySelectorAll(".single-card-container").forEach((card) => {
        card.addEventListener("click", () => {
          card.classList.toggle("is-flipped");
        });
      });

      // 2. Menú Hamburguesa
      const menuBtn = document.getElementById("menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const iconOpen = document.getElementById("icon-open");
      const iconClose = document.getElementById("icon-close");
      const mobileLinks = document.querySelectorAll(".mobile-link");

      if (menuBtn) {
        menuBtn.addEventListener("click", () => {
          if (mobileMenu) mobileMenu.classList.toggle("hidden");
          if (iconOpen) iconOpen.classList.toggle("hidden");
          if (iconClose) iconClose.classList.toggle("hidden");
        });
      }

      mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
          if (mobileMenu) mobileMenu.classList.add("hidden");
          if (iconOpen) iconOpen.classList.remove("hidden");
          if (iconClose) iconClose.classList.add("hidden");
        });
      });

      // 3. Campos Condicionales del Formulario
      const selectResidencia = document.getElementById("lugar-residencia");
      const campoSJ = document.getElementById("campo-departamento-sj");
      const campoOtraProvincia = document.getElementById(
        "campo-otra-provincia",
      );
      const campoOtroResidencia = document.getElementById(
        "campo-otro-residencia",
      );

      if (selectResidencia) {
        selectResidencia.addEventListener("change", (e) => {
          const val = e.target.value;
          if (campoSJ) campoSJ.classList.toggle("hidden", val !== "San Juan");
          if (campoOtraProvincia)
            campoOtraProvincia.classList.toggle(
              "hidden",
              val !== "Otra provincia",
            );
          if (campoOtroResidencia)
            campoOtroResidencia.classList.toggle("hidden", val !== "Otro");
        });
      }

      const radiosAsociarse = document.querySelectorAll(
        'input[name="quiere_asociarse"]',
      );
      const bloqueCategorias = document.getElementById(
        "bloque-categorias-socio",
      );
      const btnSubmit = document.getElementById("btn-submit-form");

      radiosAsociarse.forEach((radio) => {
        radio.addEventListener("change", (e) => {
          if (e.target.value === "Sí") {
            if (bloqueCategorias) bloqueCategorias.classList.remove("hidden");
            if (btnSubmit)
              btnSubmit.textContent = "Enviar Solicitud e Ir a Pagar";
          } else {
            if (bloqueCategorias) bloqueCategorias.classList.add("hidden");
            if (btnSubmit) btnSubmit.textContent = "Enviar Solicitud";
          }
        });
      });

      const selectAporte = document.getElementById("forma-aporte");
      const campoOtroAporte = document.getElementById("campo-otro-aporte");

      if (selectAporte) {
        selectAporte.addEventListener("change", (e) => {
          if (campoOtroAporte)
            campoOtroAporte.classList.toggle(
              "hidden",
              e.target.value !== "Otro",
            );
        });
      }

      const radiosJuega = document.querySelectorAll(
        'input[name="juega_en_club"]',
      );
      const contenedorDeporte = document.getElementById("opciones-deporte");

      radiosJuega.forEach((radio) => {
        radio.addEventListener("change", (e) => {
          if (contenedorDeporte)
            contenedorDeporte.classList.toggle(
              "hidden",
              e.target.value !== "Sí",
            );
        });
      });

      // 4. Copiar Datos Brubank
      const copyText = (elementId) => {
        const text = document.getElementById(elementId)?.innerText;
        if (text) {
          navigator.clipboard.writeText(text);
          alert("¡Copiado al portapapeles!");
        }
      };

      document
        .getElementById("btn-copy-cuit")
        ?.addEventListener("click", () => copyText("cuit-val"));
      document
        .getElementById("btn-copy-alias")
        ?.addEventListener("click", () => copyText("alias-val"));

      // 5. Validación y Envío del Formulario
      const form = document.getElementById("mi-formulario-actual");
      const bloquePago = document.getElementById("bloque-pago-brubank");
      const bloqueCarnet = document.getElementById("bloque-carnet-digital");

      const inputNombre = document.getElementById("nombre");
      const inputTipoDoc = document.getElementById("tipo-doc");
      const inputDoc = document.getElementById("numero-doc");
      const inputFecha = document.getElementById("fecha-nacimiento");
      const inputEmail = document.getElementById("email");
      const inputTelefono = document.getElementById("telefono");
      const codigoPais = document.getElementById("codigo-pais");
      const aceptaProtocolo = document.getElementById("acepta-protocolo");

      const mostrarError = (id, mensaje) => {
        const error = document.getElementById(id);
        if (error) {
          error.textContent = mensaje;
          error.classList.remove("hidden");
        }
      };

      const ocultarError = (id) => {
        const error = document.getElementById(id);
        if (error) error.classList.add("hidden");
      };

      const validarNombre = (valor) =>
        /^[A-Za-zÁÉÍÓÚáéíóúÑñÜü\s]+$/.test(valor.trim());
      const validarDocumento = (valor) => /^\d{7,10}$/.test(valor.trim());
      const validarEmail = (valor) =>
        /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(valor.trim());
      const validarTelefono = (valor) => {
        const limpio = valor.replace(/\D/g, "");
        return limpio.length >= 7 && limpio.length <= 15;
      };

      const validarFecha = (valor) => {
        if (!valor) return false;
        const fechaSeleccionada = new Date(`${valor}T00:00:00`);
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        return fechaSeleccionada <= hoy;
      };

      const validarFormulario = ({ validarProtocolo = false } = {}) => {
        let esValido = true;

        if (!inputNombre?.value.trim()) {
          mostrarError("error-nombre", "⚠️ Ingresá tu nombre y apellido.");
          esValido = false;
        } else if (!validarNombre(inputNombre.value)) {
          mostrarError(
            "error-nombre",
            "⚠️ El nombre solo puede contener letras y espacios.",
          );
          esValido = false;
        } else {
          ocultarError("error-nombre");
        }

        if (!inputDoc?.value.trim()) {
          mostrarError("error-doc", "⚠️ Ingresá tu número de documento.");
          esValido = false;
        } else if (!validarDocumento(inputDoc.value)) {
          mostrarError(
            "error-doc",
            "⚠️ El documento debe contener entre 7 y 10 números.",
          );
          esValido = false;
        } else {
          ocultarError("error-doc");
        }

        if (!validarFecha(inputFecha?.value || "")) {
          mostrarError("error-fecha", "⚠️ Ingresá una fecha válida.");
          esValido = false;
        } else {
          ocultarError("error-fecha");
        }

        if (!inputEmail?.value.trim() || !validarEmail(inputEmail.value)) {
          mostrarError(
            "error-email",
            "⚠️ Ingresá un correo electrónico válido.",
          );
          esValido = false;
        } else {
          ocultarError("error-email");
        }

        if (
          !inputTelefono?.value.trim() ||
          !validarTelefono(inputTelefono.value)
        ) {
          mostrarError(
            "error-telefono",
            "⚠️ El teléfono debe contener entre 7 y 15 números.",
          );
          esValido = false;
        } else {
          ocultarError("error-telefono");
        }

        if (validarProtocolo && !aceptaProtocolo?.checked) {
          alert(
            "Tenés que aceptar el Protocolo de Convivencia para enviar la solicitud.",
          );
          esValido = false;
        }

        return esValido;
      };

      [
        [inputNombre, "error-nombre"],
        [inputDoc, "error-doc"],
        [inputFecha, "error-fecha"],
        [inputEmail, "error-email"],
        [inputTelefono, "error-telefono"],
      ].forEach(([campo, errorId]) => {
        campo?.addEventListener("blur", () => {
          if (campo.value.trim()) validarFormulario();
        });
        campo?.addEventListener("input", () => ocultarError(errorId));
      });

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          if (!validarFormulario({ validarProtocolo: true })) return;

          const telefonoLimpio = inputTelefono.value.replace(/\D/g, "");
          document.getElementById("telefono-completo").value =
            `${codigoPais.value}${telefonoLimpio}`;

          if (btnSubmit) {
            btnSubmit.textContent = "Enviando solicitud...";
            btnSubmit.disabled = true;
            btnSubmit.classList.add("opacity-50", "cursor-not-allowed");
          }

          try {
            await fetch(form.action, {
              method: "POST",
              body: new FormData(form),
              mode: "no-cors",
            });

            form.classList.add("hidden");

            // Rellenar Carnet Digital con Datos
            document.getElementById("txt-nombre").textContent =
              inputNombre.value;
            document.getElementById("txt-dni").textContent =
              `${inputTipoDoc.value} ${inputDoc.value}`;

            const tipoSocioSel =
              document.querySelector('input[name="tipo_socio"]:checked')
                ?.value || "Activo";
            document.getElementById("txt-socio").textContent = tipoSocioSel;

            bloquePago?.classList.remove("hidden");
            bloqueCarnet?.classList.remove("hidden");
            bloqueCarnet?.classList.add("flex");
          } catch (error) {
            console.error("Error al enviar:", error);
            alert("Hubo un error al enviar tus datos. Intentá nuevamente.");

            if (btnSubmit) {
              btnSubmit.textContent = "Enviar Solicitud";
              btnSubmit.disabled = false;
              btnSubmit.classList.remove("opacity-50", "cursor-not-allowed");
            }
          }
        });
      }

      // 6. Modal Fixture & Galería
      const sportCards = document.querySelectorAll(".sport-card");
      const sportModal = document.getElementById("sport-modal");
      const modalContainer = document.getElementById("modal-container");
      const closeSportModal = document.getElementById("close-sport-modal");

      const modalIcon = document.getElementById("modal-icon");
      const modalSportTitle = document.getElementById("modal-sport-title");
      const categorySelectorContainer = document.getElementById(
        "category-selector-container",
      );
      const matchesListContainer = document.getElementById(
        "matches-list-container",
      );
      const modalImg = document.getElementById("modal-carrusel-img");
      const prevBtn = document.getElementById("modal-prev-btn");
      const nextBtn = document.getElementById("modal-next-btn");
      const contador = document.getElementById("modal-carrusel-contador");

      const generarRutasFotos = (carpeta) => {
        let fotos = [];
        for (let i = 1; i <= 10; i++) {
          fotos.push(`/disciplinas/${carpeta}/foto${i}.jpg`);
        }
        return fotos;
      };

      const fotosPorDisciplina = {
        "Fútbol 11": generarRutasFotos("futbol11"),
        "Futsal Masculino": generarRutasFotos("futsalMasc"),
        "Futsal Femenino": generarRutasFotos("futsalFem"),
      };

      let currentIndex = 0;
      let currentImages = [];

      sportCards.forEach((card) => {
        card.addEventListener("click", () => {
          const title = card.getAttribute("data-sport-title");
          const icon = card.getAttribute("data-sport-icon");
          const categoriesRaw = card.getAttribute("data-categories");

          let categories = [];
          try {
            categories = JSON.parse(categoriesRaw);
          } catch (e) {
            categories = [];
          }

          if (modalSportTitle) modalSportTitle.textContent = title;
          if (modalIcon) modalIcon.textContent = icon;

          currentImages = fotosPorDisciplina[title] || [
            "/disciplinas/futbol11/foto1.jpg",
          ];
          currentIndex = 0;
          updateCarousel();

          if (categorySelectorContainer)
            categorySelectorContainer.innerHTML = "";
          if (matchesListContainer) matchesListContainer.innerHTML = "";

          if (categories.length > 0 && categorySelectorContainer) {
            categories.forEach((cat, index) => {
              const btnCat = document.createElement("button");
              btnCat.type = "button";
              btnCat.className = `px-3 py-1.5 text-xs font-bold rounded-lg transition border ${
                index === 0
                  ? "bg-emerald-500 text-neutral-950 border-emerald-400"
                  : "bg-neutral-950 text-slate-300 border-neutral-800 hover:border-neutral-600"
              }`;
              btnCat.textContent = cat.name;

              btnCat.addEventListener("click", () => {
                categorySelectorContainer
                  .querySelectorAll("button")
                  .forEach((b) => {
                    b.className =
                      "px-3 py-1.5 text-xs font-bold rounded-lg transition border bg-neutral-950 text-slate-300 border-neutral-800 hover:border-neutral-600";
                  });
                btnCat.className =
                  "px-3 py-1.5 text-xs font-bold rounded-lg transition border bg-emerald-500 text-neutral-950 border-emerald-400";

                renderMatches(cat.matches);
              });

              categorySelectorContainer.appendChild(btnCat);
            });

            renderMatches(categories[0].matches);
          } else if (matchesListContainer) {
            matchesListContainer.innerHTML = `<p class="text-xs text-slate-500 italic">No hay partidos programados por el momento.</p>`;
          }

          if (sportModal) {
            sportModal.classList.remove("hidden");
            setTimeout(() => {
              if (modalContainer) {
                modalContainer.classList.remove("scale-95");
                modalContainer.classList.add("scale-100");
              }
            }, 10);
          }
        });
      });

      function renderMatches(matches) {
        if (!matchesListContainer) return;

        matchesListContainer.innerHTML = "";

        if (!matches || matches.length === 0) {
          matchesListContainer.innerHTML = `<p class="text-xs text-slate-500 italic">Sin encuentros cargados para esta categoría.</p>`;
          return;
        }

        const innerDiv = document.createElement("div");
        innerDiv.className = "flex flex-col gap-3";

        matches.forEach((m) => {
          const matchCard = document.createElement("div");

          if (m.libre) {
            matchCard.className =
              "bg-neutral-950/60 border border-neutral-800/80 p-3 rounded-xl flex items-center justify-between text-xs";
            const fecha = m.fecha || "Fecha Libre";

            matchCard.innerHTML = `
          <div>
            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wide">${fecha}</span>
            <p class="font-bold text-slate-300 text-sm mt-0.5">La Granjah</p>
          </div>
          <div class="text-right">
            <span class="bg-amber-500/10 border border-amber-500/20 text-amber-400 px-2.5 py-1 rounded-md font-semibold text-[11px] uppercase tracking-wider">
              Fecha Libre
            </span>
          </div>
        `;
          } else {
            matchCard.className =
              "bg-neutral-950 border border-neutral-800 p-3 rounded-xl flex items-center justify-between text-xs";

            const fecha = m.fecha || "Fecha";
            const rival = m.rival || "Rival a confirmar";
            const cancha = m.cancha || "Predio del club";
            const condicion = m.condicion || "Local";
            const diaHora = m.dia || "A confirmar";

            matchCard.innerHTML = `
          <div>
            <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wide">${fecha} • ${condicion}</span>
            <p class="font-bold text-slate-200 text-sm mt-0.5">vs ${rival}</p>
            <p class="text-[11px] text-slate-400 mt-1">📍 ${cancha}</p>
          </div>
          <div class="text-right">
            <span class="bg-neutral-900 border border-neutral-800 text-slate-300 px-2 py-1 rounded-md font-semibold text-[11px]">${diaHora}</span>
          </div>
        `;
          }

          innerDiv.appendChild(matchCard);
        });

        matchesListContainer.appendChild(innerDiv);
      }

      function updateCarousel() {
        if (modalImg && currentImages.length > 0) {
          modalImg.src = currentImages[currentIndex];
          if (contador)
            contador.textContent = `${currentIndex + 1} / ${currentImages.length}`;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener("click", () => {
          currentIndex =
            (currentIndex - 1 + currentImages.length) % currentImages.length;
          updateCarousel();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener("click", () => {
          currentIndex = (currentIndex + 1) % currentImages.length;
          updateCarousel();
        });
      }

      function closeModalFunc() {
        if (modalContainer) {
          modalContainer.classList.remove("scale-100");
          modalContainer.classList.add("scale-95");
        }
        setTimeout(() => {
          if (sportModal) sportModal.classList.add("hidden");
        }, 200);
      }

      if (closeSportModal)
        closeSportModal.addEventListener("click", closeModalFunc);
      if (sportModal) {
        sportModal.addEventListener("click", (e) => {
          if (e.target === sportModal) closeModalFunc();
        });
      }

      //------------- scroll limpio y directo -------------
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          e.preventDefault();
          const targetId = this.getAttribute("href");
          const targetElement = document.querySelector(targetId);

          if (targetElement) {
            // Cerramos el menú móvil por seguridad si estaba abierto
            if (mobileMenu) mobileMenu.classList.add("hidden");
            if (iconOpen) iconOpen.classList.remove("hidden");
            if (iconClose) iconClose.classList.add("hidden");

            // Scroll suave limpio hacia la sección
            targetElement.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }
        });
      });
    </script>
  </body>
</html>
