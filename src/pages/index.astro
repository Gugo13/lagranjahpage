---
import "../styles/global.css";
import Carrusel from "../components/Carrusel.astro";

const titulo = "La Granjah";
const subtitulo = "Club Social & Deportivo";
---

<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{titulo} — {subtitulo}</title>
  </head>
  <body
    class="bg-neutral-950 text-slate-100 min-h-screen font-sans flex flex-col justify-between"
  >
    <!-- HEADER CON MENÚ ADAPTATIVO -->
    <header
      class="sticky top-0 z-50 bg-neutral-950/90 backdrop-blur-md border-b border-neutral-800"
    >
      <div
        class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between"
      >
        <!-- Logo / Nombre del Club -->
        <a
          href="#"
          class="flex items-center gap-2 text-xl font-black text-slate-100 tracking-wider"
        >
          <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
          <span class="w-3 h-3 rounded-full bg-amber-400"></span>
          <span class="w-3 h-3 rounded-full bg-red-500"></span>
          <span>LA GRANJAH</span>
        </a>

        <!-- Menú exclusivo para PC -->
        <nav
          class="desktop-only flex items-center gap-8 text-sm font-semibold text-slate-300"
        >
          <a href="#disciplinas" class="hover:text-amber-400 transition"
            >Disciplinas</a
          >
          <a href="#indumentaria" class="hover:text-amber-400 transition"
            >Indumentaria</a
          >
          <a href="#identidad" class="hover:text-amber-400 transition"
            >Nuestra Esencia</a
          >
          <a
            href="#sumate"
            class="bg-gradient-to-r from-emerald-500 via-amber-400 to-red-500 text-neutral-950 font-bold px-5 py-2.5 rounded-xl hover:opacity-95 transition shadow-md"
          >
            Sumate al Club
          </a>
        </nav>

        <!-- Botón Hamburguesa exclusivo para celulares -->
        <button
          id="menu-btn"
          type="button"
          aria-label="Abrir menú"
          class="mobile-only text-slate-100 hover:text-amber-400 focus:outline-none p-2 rounded-lg bg-neutral-900 border border-neutral-800 cursor-pointer"
        >
          <svg
            id="icon-open"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="icon-close"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Desplegable Exclusivo para Celulares -->
      <div
        id="mobile-menu"
        class="hidden mobile-only bg-neutral-950/95 border-b border-neutral-800 px-6 pt-2 pb-6 space-y-3"
      >
        <nav class="flex flex-col gap-3 text-base font-medium text-slate-200">
          <a
            href="#disciplinas"
            class="mobile-link hover:text-amber-400 transition py-2 border-b border-neutral-900"
            >Disciplinas Deportivas</a
          >
          <a
            href="#indumentaria"
            class="mobile-link hover:text-amber-400 transition py-2 border-b border-neutral-900"
            >Indumentaria</a
          >
          <a
            href="#identidad"
            class="mobile-link hover:text-amber-400 transition py-2 border-b border-neutral-900"
            >Nuestra Esencia</a
          >
          <a
            href="#sumate"
            class="mobile-link text-center bg-gradient-to-r from-emerald-500 via-amber-400 to-red-500 text-neutral-950 font-black py-3 rounded-xl uppercase tracking-wider shadow-md mt-2"
            >Sumate al Club</a
          >
        </nav>
      </div>
    </header>

    <!-- ESTILOS DE VISIBILIDAD DEDICADOS -->
    <style>
      @media (max-width: 767px) {
        .desktop-only {
          display: none !important;
        }
      }
      @media (min-width: 768px) {
        .mobile-only {
          display: none !important;
        }
      }
    </style>

    <!-- HERO PRINCIPAL CON LÍNEAS DE COLORES Y DEGRADÉ -->
    <section class="py-20 md:py-28 text-center border-b border-neutral-800">
      <div class="max-w-4xl mx-auto px-6 flex flex-col items-center">
        <div class="flex items-center gap-1.5 mb-6">
          <span class="w-10 h-1 bg-emerald-500 rounded-full"></span>
          <span class="w-10 h-1 bg-amber-400 rounded-full"></span>
          <span class="w-10 h-1 bg-red-500 rounded-full"></span>
        </div>

        <h1
          class="text-4xl md:text-6xl font-black uppercase tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-amber-400 to-red-500 mb-6"
        >
          MÁS QUE UN CLUB, UNA FAMILIA
        </h1>

        <p
          class="text-lg md:text-xl text-slate-300 max-w-2xl leading-relaxed mb-8"
        >
          Un club 100% social. No recibimos aportes externos, nos bancamos con
          las cuotas de los socios y el amor gigante de cada integrante por este
          espacio.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#disciplinas"
            class="px-6 py-3 bg-neutral-900 hover:bg-neutral-800 text-slate-200 font-bold rounded-xl border border-neutral-700 transition"
          >
            Ver disciplinas
          </a>
          <a
            href="#sumate"
            class="px-6 py-3 bg-gradient-to-r from-emerald-500 via-amber-400 to-red-500 text-neutral-950 font-black rounded-xl hover:opacity-95 transition shadow-lg"
          >
            Asociate
          </a>
        </div>
      </div>
    </section>

    <!-- MANIFIESTO / IDENTIDAD -->
    <section
      id="identidad"
      class="py-16 bg-neutral-900/40 border-b border-neutral-800"
    >
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-100 mb-4">
          Unidos por los mismos valores
        </h2>
        <p
          class="text-slate-300 text-lg leading-relaxed max-w-3xl mx-auto mb-10"
        >
          Llevamos estos colores en el corazón. Nuestro nombre rinde homenaje a
          la cultura de <strong>paz</strong>, <strong>unión</strong> y <strong
            >resistencia</strong
          >. En <strong class="text-emerald-400">La Granjah</strong> cada entrenamiento,
          cada camiseta y cada partido se sostienen gracias a la comunidad.
        </p>
        <Carrusel />
      </div>
    </section>

    <!-- SECCIÓN INDUMENTARIA -->
    <section
      id="indumentaria"
      class="py-20 bg-neutral-950 border-t border-neutral-800 relative overflow-hidden"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-tr from-emerald-500/10 via-amber-500/10 to-red-500/10 blur-[140px] rounded-full pointer-events-none"
      >
      </div>

      <!-- CONTENEDOR GENERAL CON POSITION RELATIVE PARA EL CARTEL FLOTANTE -->
      <div class="max-w-6xl mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
          <span
            class="text-xs font-bold uppercase tracking-widest text-amber-400 bg-amber-500/10 border border-amber-500/20 px-3 py-1 rounded-full"
          >
            Piel Granjhistica
          </span>
          <h2
            class="text-3xl md:text-5xl font-black uppercase text-slate-100 mt-4"
          >
            Indumentaria y <span class="text-emerald-400">Accesorios</span>
          </h2>
          <p class="text-slate-400 mt-2 text-sm md:text-base">
            Pasá el cursor o tocá una carta para revelar el equipamiento oficial
            de <strong class="text-slate-200">La Granjah</strong>.
          </p>
        </div>

        <!-- WRAPPER RELATIVO PARA APLICAR EL BLUR A LAS CARDS Y PONER EL CARTEL ENCIMA -->
        <div class="relative w-full">
          <!-- CARTEL TRICOLOR FLOTANTE POR ENCIMA -->
          <div
            class="absolute inset-0 z-30 flex items-center justify-center p-4"
          >
            <div
              class="bg-neutral-900/95 border-2 border-neutral-700 px-6 py-8 sm:px-10 sm:py-10 rounded-2xl shadow-2xl max-w-lg w-full text-center backdrop-blur-md transform -rotate-1 hover:rotate-0 transition-transform duration-300"
            >
              <h3
                class="text-xl sm:text-3xl font-black uppercase tracking-wider mb-3 flex flex-wrap justify-center gap-x-2"
              >
                <span class="text-emerald-500">PRÓXIMAMENTE</span>
                <span class="text-amber-400">INDUMENTARIA</span>
                <span class="text-rose-500">GRANJHÍSTICA</span>
              </h3>
              <p class="text-neutral-400 text-sm sm:text-base">
                Se viene la nueva colección oficial. ¡Estate atento a los
                lanzamientos!
              </p>
            </div>
          </div>

          <!-- GRID DE CARDS CON BLUR APLICADO -->
          <div
            class="filter blur-md pointer-events-none select-none opacity-40 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10"
          >
            <!-- CARD 1 -->
            <div class="single-card-container group h-[420px] cursor-pointer">
              <div
                class="card-3d-inner relative w-full h-full rounded-2xl border-2 border-emerald-500/30 bg-neutral-900 transition-transform duration-[2200ms] ease-out"
              >
                <div
                  class="card-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-neutral-900"
                >
                  <span class="text-5xl mb-4">👕</span>
                  <span
                    class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-1"
                    >Edición 2026</span
                  >
                  <h3 class="text-2xl font-black uppercase text-slate-100">
                    Camiseta Granjahmaica
                  </h3>
                  <p class="text-xs text-slate-500 mt-2">
                    Inspirada en nuestros hermanos Jamaiquinos y la cultura
                    Rastafari.
                  </p>
                  <span
                    class="mt-6 text-xs text-amber-400/80 font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    ✨ Girar para revelar
                  </span>
                </div>

                <div
                  class="card-face card-back-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-between bg-neutral-950"
                >
                  <div
                    class="neon-glow-bg absolute inset-3 rounded-xl opacity-80 -z-10"
                  >
                  </div>
                  <div class="w-full text-left z-10">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-emerald-400 bg-neutral-900/90 border border-emerald-500/30 px-2.5 py-1 rounded-md"
                    >
                      Titular
                    </span>
                  </div>
                  <div
                    class="relative w-full h-52 flex items-center justify-center my-auto z-10"
                  >
                    <img
                      src="https://images.unsplash.com/photo-1580089540114-1ed5a0696377?q=80&w=600&auto=format&fit=crop"
                      alt="Camiseta Titular La Granjah"
                      class="revealed-shirt max-h-full object-contain filter drop-shadow-[0_0_20px_rgba(16,185,129,0.7)]"
                    />
                  </div>
                  <div
                    class="w-full text-center border-t border-neutral-800/80 pt-3 z-10"
                  >
                    <h4 class="text-lg font-black text-slate-100 uppercase">
                      La Cuna del Fútbol
                    </h4>
                    <p class="text-xs font-bold text-amber-400 mt-0.5">
                      $35.000 ARS
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 2 -->
            <div class="single-card-container group h-[420px] cursor-pointer">
              <div
                class="card-3d-inner relative w-full h-full rounded-2xl border-2 border-amber-500/30 bg-neutral-900 transition-transform duration-[2200ms] ease-out"
              >
                <div
                  class="card-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-neutral-900"
                >
                  <span class="text-5xl mb-4">🛡️</span>
                  <span
                    class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-1"
                    >Edición Especial</span
                  >
                  <h3 class="text-2xl font-black uppercase text-slate-100">
                    Camiseta Suplente
                  </h3>
                  <p class="text-xs text-slate-500 mt-2">
                    Negro Faraón con vivos Neón
                  </p>
                  <span
                    class="mt-6 text-xs text-amber-400/80 font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    ✨ Girar para revelar
                  </span>
                </div>

                <div
                  class="card-face card-back-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-between bg-neutral-950"
                >
                  <div
                    class="neon-glow-bg absolute inset-3 rounded-xl opacity-80 -z-10"
                  >
                  </div>
                  <div class="w-full text-left z-10">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-amber-400 bg-neutral-900/90 border border-amber-500/30 px-2.5 py-1 rounded-md"
                    >
                      Alternativa
                    </span>
                  </div>
                  <div
                    class="relative w-full h-52 flex items-center justify-center my-auto z-10"
                  >
                    <img
                      src="https://images.unsplash.com/photo-1521572267360-ee0c2909d518?q=80&w=600&auto=format&fit=crop"
                      alt="Camiseta Suplente La Granjah"
                      class="revealed-shirt max-h-full object-contain filter drop-shadow-[0_0_20px_rgba(251,191,36,0.7)]"
                    />
                  </div>
                  <div
                    class="w-full text-center border-t border-neutral-800/80 pt-3 z-10"
                  >
                    <h4 class="text-lg font-black text-slate-100 uppercase">
                      Noche Faraónica
                    </h4>
                    <p class="text-xs font-bold text-amber-400 mt-0.5">
                      $35.000 ARS
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 3 -->
            <div class="single-card-container group h-[420px] cursor-pointer">
              <div
                class="card-3d-inner relative w-full h-full rounded-2xl border-2 border-red-500/30 bg-neutral-900 transition-transform duration-[2200ms] ease-out"
              >
                <div
                  class="card-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-neutral-900"
                >
                  <span class="text-5xl mb-4">🔥</span>
                  <span
                    class="text-xs font-bold uppercase tracking-widest text-red-500 mb-1"
                    >Entrenamiento</span
                  >
                  <h3 class="text-2xl font-black uppercase text-slate-100">
                    Camiseta Pre-Match
                  </h3>
                  <p class="text-xs text-slate-500 mt-2">
                    Llamas Granjhisticas
                  </p>
                  <span
                    class="mt-6 text-xs text-amber-400/80 font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    ✨ Girar para revelar
                  </span>
                </div>

                <div
                  class="card-face card-back-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-between bg-neutral-950"
                >
                  <div
                    class="neon-glow-bg absolute inset-3 rounded-xl opacity-80 -z-10"
                  >
                  </div>
                  <div class="w-full text-left z-10">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-red-400 bg-neutral-900/90 border border-red-500/30 px-2.5 py-1 rounded-md"
                    >
                      Pre-Match
                    </span>
                  </div>
                  <div
                    class="relative w-full h-52 flex items-center justify-center my-auto z-10"
                  >
                    <img
                      src="https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?q=80&w=600&auto=format&fit=crop"
                      alt="Camiseta Pre-Match La Granjah"
                      class="revealed-shirt max-h-full object-contain filter drop-shadow-[0_0_20px_rgba(239,68,68,0.7)]"
                    />
                  </div>
                  <div
                    class="w-full text-center border-t border-neutral-800/80 pt-3 z-10"
                  >
                    <h4 class="text-lg font-black text-slate-100 uppercase">
                      Calentamiento Oficial
                    </h4>
                    <p class="text-xs font-bold text-amber-400 mt-0.5">
                      $28.000 ARS
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 4 -->
            <div class="single-card-container group h-[420px] cursor-pointer">
              <div
                class="card-3d-inner relative w-full h-full rounded-2xl border-2 border-emerald-500/30 bg-neutral-900 transition-transform duration-[2200ms] ease-out"
              >
                <div
                  class="card-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-neutral-900"
                >
                  <span class="text-5xl mb-4">🦵</span>
                  <span
                    class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-1"
                    >Protección</span
                  >
                  <h3 class="text-2xl font-black uppercase text-slate-100">
                    Canilleras Pro
                  </h3>
                  <p class="text-xs text-slate-500 mt-2">
                    Fibra Reforzada y Escudo
                  </p>
                  <span
                    class="mt-6 text-xs text-amber-400/80 font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    ✨ Girar para revelar
                  </span>
                </div>

                <div
                  class="card-face card-back-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-between bg-neutral-950"
                >
                  <div
                    class="neon-glow-bg absolute inset-3 rounded-xl opacity-80 -z-10"
                  >
                  </div>
                  <div class="w-full text-left z-10">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-emerald-400 bg-neutral-900/90 border border-emerald-500/30 px-2.5 py-1 rounded-md"
                    >
                      Accesorios
                    </span>
                  </div>
                  <div
                    class="relative w-full h-52 flex items-center justify-center my-auto z-10"
                  >
                    <img
                      src="https://images.unsplash.com/photo-1511886929837-354d827aae26?q=80&w=600&auto=format&fit=crop"
                      alt="Canilleras Oficiales La Granjah"
                      class="revealed-shirt max-h-full object-contain filter drop-shadow-[0_0_20px_rgba(16,185,129,0.7)]"
                    />
                  </div>
                  <div
                    class="w-full text-center border-t border-neutral-800/80 pt-3 z-10"
                  >
                    <h4 class="text-lg font-black text-slate-100 uppercase">
                      Armadura Granjhística
                    </h4>
                    <p class="text-xs font-bold text-amber-400 mt-0.5">
                      $14.000 ARS
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 5 -->
            <div class="single-card-container group h-[420px] cursor-pointer">
              <div
                class="card-3d-inner relative w-full h-full rounded-2xl border-2 border-amber-500/30 bg-neutral-900 transition-transform duration-[2200ms] ease-out"
              >
                <div
                  class="card-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-neutral-900"
                >
                  <span class="text-5xl mb-4">🧦</span>
                  <span
                    class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-1"
                    >Complementos</span
                  >
                  <h3 class="text-2xl font-black uppercase text-slate-100">
                    Medias Oficiales
                  </h3>
                  <p class="text-xs text-slate-500 mt-2">
                    Tecnología Antideslizante
                  </p>
                  <span
                    class="mt-6 text-xs text-amber-400/80 font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    ✨ Girar para revelar
                  </span>
                </div>

                <div
                  class="card-face card-back-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-between bg-neutral-950"
                >
                  <div
                    class="neon-glow-bg absolute inset-3 rounded-xl opacity-80 -z-10"
                  >
                  </div>
                  <div class="w-full text-left z-10">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-amber-400 bg-neutral-900/90 border border-amber-500/30 px-2.5 py-1 rounded-md"
                    >
                      Juego Completo
                    </span>
                  </div>
                  <div
                    class="relative w-full h-52 flex items-center justify-center my-auto z-10"
                  >
                    <img
                      src="https://images.unsplash.com/photo-1586350977771-b3b0abd50c82?q=80&w=600&auto=format&fit=crop"
                      alt="Medias Oficiales La Granjah"
                      class="revealed-shirt max-h-full object-contain filter drop-shadow-[0_0_20px_rgba(251,191,36,0.7)]"
                    />
                  </div>
                  <div
                    class="w-full text-center border-t border-neutral-800/80 pt-3 z-10"
                  >
                    <h4 class="text-lg font-black text-slate-100 uppercase">
                      Medias de Competencia
                    </h4>
                    <p class="text-xs font-bold text-amber-400 mt-0.5">
                      $8.500 ARS
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- CARD 6 -->
            <div class="single-card-container group h-[420px] cursor-pointer">
              <div
                class="card-3d-inner relative w-full h-full rounded-2xl border-2 border-red-500/30 bg-neutral-900 transition-transform duration-[2200ms] ease-out"
              >
                <div
                  class="card-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-center text-center bg-neutral-900"
                >
                  <span class="text-5xl mb-4">🧥</span>
                  <span
                    class="text-xs font-bold uppercase tracking-widest text-red-500 mb-1"
                    >Paseo / Salida</span
                  >
                  <h3 class="text-2xl font-black uppercase text-slate-100">
                    Conjunto Buzo
                  </h3>
                  <p class="text-xs text-slate-500 mt-2">
                    Campera + Chándal de Salida
                  </p>
                  <span
                    class="mt-6 text-xs text-amber-400/80 font-semibold uppercase tracking-wider flex items-center gap-1"
                  >
                    ✨ Girar para revelar
                  </span>
                </div>

                <div
                  class="card-face card-back-face absolute inset-0 rounded-2xl p-6 flex flex-col items-center justify-between bg-neutral-950"
                >
                  <div
                    class="neon-glow-bg absolute inset-3 rounded-xl opacity-80 -z-10"
                  >
                  </div>
                  <div class="w-full text-left z-10">
                    <span
                      class="text-[10px] font-black uppercase tracking-widest text-red-400 bg-neutral-900/90 border border-red-500/30 px-2.5 py-1 rounded-md"
                    >
                      Conjunto
                    </span>
                  </div>
                  <div
                    class="relative w-full h-52 flex items-center justify-center my-auto z-10"
                  >
                    <img
                      src="https://images.unsplash.com/photo-1556905055-8f358a7a47b2?q=80&w=600&auto=format&fit=crop"
                      alt="Conjunto de Buzo La Granjah"
