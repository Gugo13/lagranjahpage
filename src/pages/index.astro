                  <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <img
                      src="/escudo/escudoLagranjah.png"
                      alt="Escudo La Granjah"
                      style="width: 2rem; height: 2rem; object-fit: contain;"
                    />
                    <span
                      id="texto-titulo"
                      style="color: #ffffff; font-weight: 900; letter-spacing: 0.05em; text-transform: uppercase; font-size: 1.125rem;"
                      >La Granjah</span
                    >
                  </div>
                  <span
                    id="badge-socio"
                    style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #34d399; background-color: #064e3b; padding-left: 0.625rem; padding-right: 0.625rem; padding-top: 0.25rem; padding-bottom: 0.25rem; border-radius: 9999px; border: 1px solid #065f46;"
                    >Socio Activo</span
                  >
                </div>

                <!-- Cuerpo: Foto y Datos -->
                <div
                  style="display: flex; align-items: center; gap: 1rem; margin-top: auto; margin-bottom: auto; position: relative; z-index: 10;"
                >
                  <div
                    id="contenedor-foto"
                    style="width: 5rem; height: 6rem; background-color: #1e293b; border-radius: 0.5rem; border: 2px solid #334155; display: flex; align-items: center; justify-content: center; color: #64748b; font-size: 0.75rem; font-weight: 500; text-align: center; overflow: hidden; flex-shrink: 0;"
                  >
                    FOTO
                  </div>
                  <div
                    style="display: flex; flex-direction: column; gap: 0.25rem;"
                  >
                    <div>
                      <p
                        id="label-nombre"
                        style="font-size: 0.625rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;"
                      >
                        Apellido y Nombre
                      </p>
                      <p
                        id="txt-nombre"
                        style="color: #ffffff; font-weight: 700; font-size: 1rem; line-height: 1.25;"
                      >
                        Cargando...
                      </p>
                    </div>
                    <div>
                      <p
                        style="font-size: 0.625rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;"
                      >
                        DNI
                      </p>
                      <p
                        id="txt-dni"
                        style="color: #e2e8f0; font-size: 0.875rem; font-family: monospace;"
                      >
                        -
                      </p>
                    </div>
                    <div>
                      <p
                        style="font-size: 0.625rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;"
                      >
                        Categoría
                      </p>
                      <p
                        id="txt-socio"
                        style="color: #fbbf24; font-family: monospace; font-weight: 700; font-size: 0.875rem;"
                      >
                        Activo
                      </p>
                    </div>
                  </div>
                </div>
                <div style="height: 0.25rem; position: relative; z-index: 10;">
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PIE DE PÁGINA CON ESCUDO CENTRADO Y DESTACADO -->
    <footer
      class="border-t border-neutral-800 bg-neutral-950 py-12 relative overflow-hidden"
    >
      <div
        class="max-w-6xl mx-auto px-6 flex flex-col items-center justify-center gap-6 text-center"
      >
        <!-- Escudo centrado y con buen tamaño para que se luzca -->
        <div
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-neutral-700 bg-neutral-900 shadow-xl p-1 transition hover:scale-105 duration-300"
        >
          <img
            src="/escudo/escudoLagranjah.png"
            alt="Escudo Oficial La Granjah"
            class="w-full h-full object-cover rounded-full"
          />
        </div>

        <!-- Título y Puntos de colores -->
        <div class="flex flex-col items-center gap-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-red-500"></span>
          </div>
          <div>
            <span
              class="text-xl font-black uppercase text-slate-100 tracking-wider"
              >{titulo}</span
            >
            <p class="text-xs text-slate-400 mt-1">{subtitulo}</p>
          </div>
        </div>

        <!-- Derechos / Copyright -->
        <p
          class="text-xs text-slate-500 border-t border-neutral-900 pt-6 w-full max-w-md"
        >
          &copy; {new Date().getFullYear()} La Granjah. Hecho con amor por y para
          el club.
        </p>
      </div>
    </footer>
  </body>

  <!-- SCRIPT -->
  <script is:inline>
    // 1. Giro de Tarjetas Generales
    document.querySelectorAll(".single-card-container").forEach((card) => {
      card.addEventListener("click", () => {
        card.classList.toggle("is-flipped");
      });
    });

    // 2. Lógica Menú Hamburguesa
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    if (menuBtn) {
      menuBtn.addEventListener("click", () => {
        if (mobileMenu) mobileMenu.classList.toggle("hidden");
        if (iconOpen) iconOpen.classList.toggle("hidden");
        if (iconClose) iconClose.classList.toggle("hidden");
      });
    }

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        if (mobileMenu) mobileMenu.classList.add("hidden");
        if (iconOpen) iconOpen.classList.remove("hidden");
        if (iconClose) iconClose.classList.add("hidden");
      });
    });

    // 3. Lógica de Campos Condicionales del Formulario
    const selectResidencia = document.getElementById("lugar-residencia");
    const campoSJ = document.getElementById("campo-departamento-sj");
    const campoOtraProvincia = document.getElementById("campo-otra-provincia");
    const campoOtroResidencia = document.getElementById(
      "campo-otro-residencia",
    );

    if (selectResidencia) {
      selectResidencia.addEventListener("change", (e) => {
        const val = e.target.value;
        if (campoSJ) campoSJ.classList.toggle("hidden", val !== "San Juan");
        if (campoOtraProvincia)
          campoOtraProvincia.classList.toggle(
            "hidden",
            val !== "Otra provincia",
          );
        if (campoOtroResidencia)
          campoOtroResidencia.classList.toggle("hidden", val !== "Otro");
      });
    }

    const radiosAsociarse = document.querySelectorAll(
      'input[name="quiere_asociarse"]',
    );
    const bloqueCategorias = document.getElementById("bloque-categorias-socio");
    const btnSubmit = document.getElementById("btn-submit-form");

    radiosAsociarse.forEach((radio) => {
      radio.addEventListener("change", (e) => {
        if (e.target.value === "Sí") {
          if (bloqueCategorias) bloqueCategorias.classList.remove("hidden");
          if (btnSubmit)
            btnSubmit.textContent = "Enviar Solicitud e Ir a Pagar";
        } else {
          if (bloqueCategorias) bloqueCategorias.classList.add("hidden");
          if (btnSubmit) btnSubmit.textContent = "Enviar Solicitud";
        }
      });
    });

    const selectAporte = document.getElementById("forma-aporte");
    const campoOtroAporte = document.getElementById("campo-otro-aporte");

    if (selectAporte) {
      selectAporte.addEventListener("change", (e) => {
        const val = e.target.value;
        if (campoOtroAporte)
          campoOtroAporte.classList.toggle("hidden", val !== "Otro");
      });
    }

    const radiosJuega = document.querySelectorAll(
      'input[name="juega_en_club"]',
    );
    const contenedorDeporte = document.getElementById("opciones-deporte");

    radiosJuega.forEach((radio) => {
      radio.addEventListener("change", (e) => {
        if (contenedorDeporte)
          contenedorDeporte.classList.toggle("hidden", e.target.value !== "Sí");
      });
    });

    // 4. Lógica de Foto (Archivo o Cámara)
    const btnModoArchivo = document.getElementById("btn-modo-archivo");
    const btnModoCamara = document.getElementById("btn-modo-camara");
    const contenedorArchivo = document.getElementById(
      "contenedor-modo-archivo",
    );
    const contenedorCamara = document.getElementById("contenedor-modo-camara");

    const videoCamara = document.getElementById("video-camara");
    const canvasCamara = document.getElementById("canvas-camara");
    const btnCapturar = document.getElementById("btn-capturar-foto");
    const previewCapturada = document.getElementById("preview-foto-capturada");
    const imagenCapturada = document.getElementById("imagen-capturada");
    const btnRepetir = document.getElementById("btn-repetir-foto");
    const inputFotoSocio = document.getElementById("foto-perfil");

    let streamCamara = null;
    let archivoFotoFinal = null;

    if (btnModoArchivo && btnModoCamara) {
      btnModoArchivo.addEventListener("click", () => {
        contenedorArchivo.classList.remove("hidden");
        contenedorCamara.classList.add("hidden");
        btnModoArchivo.className =
          "flex-1 py-2 text-xs font-black bg-amber-400 text-neutral-950 rounded-xl transition";
        btnModoCamara.className =
          "flex-1 py-2 text-xs font-black bg-neutral-900 text-slate-300 border border-neutral-800 rounded-xl hover:text-white transition";
        detenerCamara();
      });

      btnModoCamara.addEventListener("click", async () => {
        contenedorArchivo.classList.add("hidden");
        contenedorCamara.classList.remove("hidden");
        btnModoCamara.className =
          "flex-1 py-2 text-xs font-black bg-amber-400 text-neutral-950 rounded-xl transition";
        btnModoArchivo.className =
          "flex-1 py-2 text-xs font-black bg-neutral-900 text-slate-300 border border-neutral-800 rounded-xl hover:text-white transition";
        await iniciarCamara();
      });
    }

    async function iniciarCamara() {
      try {
        streamCamara = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user" },
          audio: false,
        });
        if (videoCamara) videoCamara.srcObject = streamCamara;
      } catch (err) {
        console.error("No se pudo acceder a la cámara:", err);
        alert(
          "No pudimos acceder a tu cámara. Revisa los permisos o elegí subir un archivo.",
        );
      }
    }

    function detenerCamara() {
      if (streamCamara) {
        streamCamara.getTracks().forEach((track) => track.stop());
        streamCamara = null;
      }
    }

    if (btnCapturar) {
      btnCapturar.addEventListener("click", () => {
        if (!videoCamara) return;
        const context = canvasCamara.getContext("2d");
        canvasCamara.width = videoCamara.videoWidth || 300;
        canvasCamara.height = videoCamara.videoHeight || 300;
        context.drawImage(
          videoCamara,
          0,
          0,
          canvasCamara.width,
          canvasCamara.height,
        );

        canvasCamara.toBlob(
          (blob) => {
            archivoFotoFinal = new File([blob], "foto-camara.jpg", {
              type: "image/jpeg",
            });
            const urlTemporal = URL.createObjectURL(archivoFotoFinal);
            imagenCapturada.src = urlTemporal;
            videoCamara.classList.add("hidden");
            btnCapturar.classList.add("hidden");
            previewCapturada.classList.remove("hidden");
            detenerCamara();
          },
          "image/jpeg",
          0.8,
        );
      });
    }

    if (btnRepetir) {
      btnRepetir.addEventListener("click", async () => {
        archivoFotoFinal = null;
        previewCapturada.classList.add("hidden");
        videoCamara.classList.remove("hidden");
        btnCapturar.classList.remove("hidden");
        await iniciarCamara();
      });
    }

    if (inputFotoSocio) {
      inputFotoSocio.addEventListener("change", (e) => {
        if (e.target.files && e.target.files[0]) {
          archivoFotoFinal = e.target.files[0];
        }
      });
    }

    // 5. Envío y Validación del Formulario con Cloudinary para la tarjeta generada
    const form = document.getElementById("mi-formulario-actual");
    const bloquePago = document.getElementById("bloque-pago-brubank");
    const bloqueCarnet = document.getElementById("bloque-carnet-digital");

    const inputNombre = document.getElementById("nombre");
    const inputDoc = document.getElementById("numero-doc");
    const inputFecha = document.getElementById("fecha-nacimiento");

    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        let esValido = true;

        if (!inputNombre || !inputNombre.value.trim()) esValido = false;
        if (!inputDoc || !inputDoc.value.trim()) esValido = false;
        if (!inputFecha || !inputFecha.value) esValido = false;

        if (esValido) {
          if (btnSubmit) {
            btnSubmit.textContent = "Generando carnet y guardando...";
            btnSubmit.disabled = true;
            btnSubmit.classList.add("opacity-50", "cursor-not-allowed");
          }

          // Rellenar datos en el diseño de la tarjeta del carnet
          const inputCategoriaSeleccionada = document.querySelector(
            'input[name="tipo_socio"]:checked',
          );
          const txtSocioCarnet = document.getElementById("txt-socio");
          if (inputCategoriaSeleccionada && txtSocioCarnet) {
            const labelPadre = inputCategoriaSeleccionada.closest("label");
            txtSocioCarnet.textContent = labelPadre
              ? labelPadre.querySelector("span").textContent.trim()
              : inputCategoriaSeleccionada.value;
          }

          const txtNombreCarnet = document.getElementById("txt-nombre");
          const txtDniCarnet = document.getElementById("txt-dni");
          const txtFechaCarnet = document.getElementById("txt-fecha");

          if (txtNombreCarnet && inputNombre)
            txtNombreCarnet.textContent = inputNombre.value;
          if (txtDniCarnet && inputDoc)
            txtDniCarnet.textContent = inputDoc.value;
          if (txtFechaCarnet && inputFecha)
            txtFechaCarnet.textContent = inputFecha.value;

          const enviarAlServidor = (payloadParams) => {
            fetch(form.action, {
              method: "POST",
              body: payloadParams,
            })
              .then((res) => res.json())
              .then(() => {
                form.classList.add("hidden");
                if (bloquePago) bloquePago.classList.remove("hidden");
                if (bloqueCarnet) bloqueCarnet.classList.remove("hidden");
              })
              .catch((err) => {
                console.error("Error al guardar:", err);
                form.classList.add("hidden");
                if (bloquePago) bloquePago.classList.remove("hidden");
                if (bloqueCarnet) bloqueCarnet.classList.remove("hidden");
              });
          };

          const procesarYEnviarCarnet = async (fotoPerfilBase64) => {
            if (fotoPerfilBase64) {
              const contenedorFoto = document.getElementById("contenedor-foto");
              if (contenedorFoto) {
                // CORREGIDO: Se usan estilos en línea en vez de clases de Tailwind
                contenedorFoto.innerHTML = `<img src="${fotoPerfilBase64}" alt="Foto Socio" style="width: 100%; height: 100%; object-fit: cover;">`;
              }
            }

            const elementoTarjeta = document.getElementById("tarjeta-carnet");
            const paramsData = new URLSearchParams();
            const formData = new FormData(form);

            for (const [key, value] of formData.entries()) {
              if (key !== "foto_perfil" && value) {
                paramsData.append(key, value);
              }
            }

            if (elementoTarjeta) {
              try {
                elementoTarjeta.style.display = "flex";
                elementoTarjeta.style.backgroundColor = "#0f172a";

                const canvas = await html2canvas(elementoTarjeta, {
                  scale: 1.5,
                  useCORS: true,
                  backgroundColor: "#0f172a",
                  onclone: (clonedDoc) => {
                    // Elimina temporalmente las hojas de estilo de Tailwind del clon para evitar el error oklch
                    const styles = clonedDoc.querySelectorAll(
                      'style, link[rel="stylesheet"]',
                    );
                    styles.forEach((s) => s.remove());
                  },
                });

                // Convertimos el canvas a blob para subirlo limpiamente a Cloudinary
                canvas.toBlob(
                  async (blob) => {
                    try {
                      const formDataCloudinary = new FormData();
                      formDataCloudinary.append("file", blob);
                      formDataCloudinary.append("upload_preset", "la granjah");
                      formDataCloudinary.append("folder", "carnets_socios"); // Organización automática en Cloudinary

                      const respuestaCloud = await fetch(
                        "https://api.cloudinary.com/v1_1/ffv1vsn2/image/upload",
                        {
                          method: "POST",
                          body: formDataCloudinary,
                        },
                      );
                      const datosCloud = await respuestaCloud.json();

                      if (datosCloud.secure_url) {
                        paramsData.append("url_carnet", datosCloud.secure_url);
                      }
                    } catch (errCloud) {
                      console.error(
                        "Error al subir carnet a Cloudinary:",
                        errCloud,
                      );
                    }

                    enviarAlServidor(paramsData);
                  },
                  "image/jpeg",
                  0.8,
                );
              } catch (errCanvas) {
                console.error(
                  "Error al generar imagen de la tarjeta:",
                  errCanvas,
                );
                enviarAlServidor(paramsData);
              }
            } else {
              enviarAlServidor(paramsData);
            }
          };

          if (archivoFotoFinal) {
            const reader = new FileReader();
            reader.readAsDataURL(archivoFotoFinal);
            reader.onload = function () {
              procesarYEnviarCarnet(reader.result);
            };
          } else {
            procesarYEnviarCarnet("");
          }
        }
      });
    }

    // 6. Lógica de Disciplinas Deportivas (Fixture y Carrusel Local)
    const sportCards = document.querySelectorAll(".sport-card");
    const sportModal = document.getElementById("sport-modal");
    const modalContainer = document.getElementById("modal-container");
    const closeSportModal = document.getElementById("close-sport-modal");

    const modalIcon = document.getElementById("modal-icon");
    const modalSportTitle = document.getElementById("modal-sport-title");
    const categorySelectorContainer = document.getElementById(
      "category-selector-container",
    );
    const matchesListContainer = document.getElementById(
      "matches-list-container",
    );
    const modalImg = document.getElementById("modal-carrusel-img");
    const prevBtn = document.getElementById("modal-prev-btn");
    const nextBtn = document.getElementById("modal-next-btn");
    const contador = document.getElementById("modal-carrusel-contador");

    const generarRutasFotos = (carpeta) => {
      let fotos = [];
      for (let i = 1; i <= 10; i++) {
        fotos.push(`/disciplinas/${carpeta}/foto${i}.jpg`);
      }
      return fotos;
    };

    const fotosPorDisciplina = {
      "Fútbol 11": generarRutasFotos("futbol11"),
      "Futsal Masculino": generarRutasFotos("futsalMasc"),
      "Futsal Femenino": generarRutasFotos("futsalFem"),
    };

    let currentIndex = 0;
    let currentImages = [];

    sportCards.forEach((card) => {
      card.addEventListener("click", () => {
        const title = card.getAttribute("data-sport-title");
        const icon = card.getAttribute("data-sport-icon");
        const categoriesRaw = card.getAttribute("data-categories");

        let categories = [];
        try {
          categories = JSON.parse(categoriesRaw);
        } catch (e) {
          categories = [];
        }

        if (modalSportTitle) modalSportTitle.textContent = title;
        if (modalIcon) modalIcon.textContent = icon;

        currentImages = fotosPorDisciplina[title] || [
          "/disciplinas/futbol11/foto1.jpg",
        ];
        currentIndex = 0;
        updateCarousel();

        if (categorySelectorContainer) categorySelectorContainer.innerHTML = "";
        if (matchesListContainer) matchesListContainer.innerHTML = "";

        if (categories.length > 0 && categorySelectorContainer) {
          categories.forEach((cat, index) => {
            const btnCat = document.createElement("button");
            btnCat.type = "button";
            btnCat.className = `px-3 py-1.5 text-xs font-bold rounded-lg transition border ${
              index === 0
                ? "bg-emerald-500 text-neutral-950 border-emerald-400"
                : "bg-neutral-950 text-slate-300 border-neutral-800 hover:border-neutral-600"
            }`;
            btnCat.textContent = cat.name;

            btnCat.addEventListener("click", () => {
              categorySelectorContainer
                .querySelectorAll("button")
                .forEach((b) => {
                  b.className =
                    "px-3 py-1.5 text-xs font-bold rounded-lg transition border bg-neutral-950 text-slate-300 border-neutral-800 hover:border-neutral-600";
                });
              btnCat.className =
                "px-3 py-1.5 text-xs font-bold rounded-lg transition border bg-emerald-500 text-neutral-950 border-emerald-400";

              renderMatches(cat.matches);
            });

            categorySelectorContainer.appendChild(btnCat);
          });

          renderMatches(categories[0].matches);
        } else if (matchesListContainer) {
          matchesListContainer.innerHTML = `<p class="text-xs text-slate-500 italic">No hay partidos programados por el momento.</p>`;
        }

        if (sportModal) {
          sportModal.classList.remove("hidden");
          setTimeout(() => {
            if (modalContainer) {
              modalContainer.classList.remove("scale-95");
              modalContainer.classList.add("scale-100");
            }
          }, 10);
        }
      });
    });

    function renderMatches(matches) {
      if (!matchesListContainer) return;
      matchesListContainer.innerHTML = "";
      if (!matches || matches.length === 0) {
        matchesListContainer.innerHTML = `<p class="text-xs text-slate-500 italic">Sin encuentros cargados para esta categoría.</p>`;
        return;
      }

      matches.forEach((m) => {
        const matchCard = document.createElement("div");
        matchCard.className =
          "bg-neutral-950 border border-neutral-800 p-3 rounded-xl flex items-center justify-between text-xs";

        const fecha = m.fecha || "Fecha";
        const rival = m.rival || "Rival a confirmar";
        const cancha = m.cancha || "Predio del club";
        const condicion = m.condition || m.condicion || "Local";
        const diaHora = m.date || m.dia || "A confirmar";

        matchCard.innerHTML = `
          <div>
            <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wide">${fecha} • ${condicion}</span>
            <p class="font-bold text-slate-200 text-sm mt-0.5">vs ${rival}</p>
            <p class="text-[11px] text-slate-400 mt-1">📍 ${cancha}</p>
          </div>
          <div class="text-right">
            <span class="bg-neutral-900 border border-neutral-800 text-slate-300 px-2 py-1 rounded-md font-semibold text-[11px]">${diaHora}</span>
          </div>
        `;
        matchesListContainer.appendChild(matchCard);
      });
    }

    function updateCarousel() {
      if (modalImg && currentImages.length > 0) {
        modalImg.src = currentImages[currentIndex];
        if (contador)
          contador.textContent = `${currentIndex + 1} / ${currentImages.length}`;
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", () => {
        currentIndex =
          (currentIndex - 1 + currentImages.length) % currentImages.length;
        updateCarousel();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", () => {
        currentIndex = (currentIndex + 1) % currentImages.length;
        updateCarousel();
      });
    }

    function closeModalFunc() {
      if (modalContainer) {
        modalContainer.classList.remove("scale-100");
        modalContainer.classList.add("scale-95");
      }
      setTimeout(() => {
        if (sportModal) sportModal.classList.add("hidden");
      }, 200);
    }

    if (closeSportModal)
      closeSportModal.addEventListener("click", closeModalFunc);
    if (sportModal) {
      sportModal.addEventListener("click", (e) => {
        if (e.target === sportModal) closeModalFunc();
      });
    }
  </script>
</html>
